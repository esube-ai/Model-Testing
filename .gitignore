# .gitignore — keep secrets, generated output, binaries, personal documents and files that
# reveal local machine details (usernames, absolute paths, directory listings) out of git.
#
# Note: ignoring a file does NOT remove it if it was already committed. If a secret was
# ever committed, rotate it, then remove it from history.

# ─── Secrets and credentials ────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.env
.envrc
.secrets
secrets.json
secrets.yaml
secrets.yml
secrets.toml
*.secret
*.secrets
credentials*.json
service-account*.json
*-service-account.json
client_secret*.json
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.kdbx
*.gpg
*.asc
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
.netrc
.htpasswd
# Package-manager config can hold registry auth tokens
.npmrc
.yarnrc
.yarnrc.yml
.pypirc
# Cloud and deployment CLIs (contain project/org IDs, tokens)
.vercel/
.aws/
.azure/
.gcloud/
.terraform/
*.tfstate
*.tfstate.*

# ─── Dependencies ───────────────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/releases
jspm_packages/
bower_components/

# ─── Build output and caches (contain absolute paths of the build machine) ──────────────
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo
.turbo/
.swc/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.vite/
storybook-static/

# ─── Tests and coverage (traces and reports embed local paths, screenshots and data) ────
playwright-report/
test-results/
blob-report/
playwright/.cache/
coverage/
.nyc_output/
*.lcov
junit*.xml

# ─── Logs, crash reports and debug dumps (can contain env vars, paths, request data) ────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.json
*.heapsnapshot
*.heapprofile
*.cpuprofile
/core
core.[0-9]*
*.dmp
hs_err_pid*

# ─── Documents and data testers might drop in the folder (could be confidential) ────────
# Test fixtures are generated in code (tests/fixtures/files.ts), so none are needed here.
*.pdf
*.doc
*.docx
*.xls
*.xlsx
*.ppt
*.pptx
*.odt
*.ods
*.odp
*.pages
*.numbers
# Conversation exports from the app may contain private chats
exports/
downloads/
# Local databases and dumps
*.sqlite
*.sqlite3
*.db
*.db-journal
*.dump
*.sql.gz

# ─── Binaries, archives and packages ────────────────────────────────────────────────────
*.exe
*.dll
*.so
*.so.*
*.dylib
*.bin
*.o
*.obj
*.a
*.lib
*.class
*.jar
*.war
*.pyc
__pycache__/
*.wasm
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.xz
*.7z
*.rar
*.dmg
*.iso
*.img
*.pkg
*.deb
*.rpm
*.msi
*.apk
*.ipa

# ─── Editor and IDE files (contain absolute paths, usernames, local settings) ───────────
.idea/
.vscode/*
!.vscode/extensions.json
*.code-workspace
.history/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
*.swp
*.swo
*~
\#*\#
.\#*
.fleet/
.zed/

# ─── Operating-system files (reveal directory listings and folder structure) ────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.DocumentRevisions-V100
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump
.directory
.fuse_hidden*
.nfs*
.Trash-*

# ─── Backups and temporary files ────────────────────────────────────────────────────────
*.bak
*.backup
*.old
*.orig
*.rej
*.tmp
*.temp
tmp/
temp/

# ─── AI assistant local files (personal settings, may contain paths or tokens) ──────────
.claude/settings.local.json
CLAUDE.local.md
